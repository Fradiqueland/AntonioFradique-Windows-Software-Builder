{
  "appId": "com.launchbox.builder",
  "productName": "LaunchBox Builder",
  "directories": {
    "output": "dist/builder"
  },
  "files": [
    "main.js",
    "preload.js",
    "preload-viewer.js",
    "src/builder/**/*",
    "src/viewer/**/*",
    "locales/**/*",
    "!src/builder/templates/**",
    "!src/builder/bin/**",
    "!build-configs/**",
    "!scripts/**",
    "!dist/**"
  ],
  "extraResources": [
    { "from": "build-configs/builder-mode/app-mode.json", "to": "app-mode.json" },
    { "from": "src/builder/bin", "to": "sfx" },
    { "from": "src/builder/templates/viewer-core/win-unpacked", "to": "viewer-template" }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "LaunchBox Builder"
  }
}
