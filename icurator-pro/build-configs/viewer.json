{
  "appId": "com.launchbox.viewer",
  "productName": "LaunchBox Viewer",
  "directories": {
    "output": "dist/viewer",
    "buildResources": "build-configs/build-resources"
  },
  "files": [
    "main.js",
    "preload.js",
    "preload-viewer.js",
    "src/**/*",
    "locales/**/*",
    "!build-configs/**",
    "!dist/**",
    "!release/**"
  ],
  "extraResources": [
    { "from": "build-configs/viewer-mode/app-mode.json", "to": "app-mode.json" }
  ],
  "fileAssociations": [
    {
      "ext": "lbpro",
      "name": "LaunchBox Project",
      "description": "LaunchBox Pro course package",
      "role": "Viewer"
    }
  ],
  "win": {
    "target": "nsis"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "LaunchBox Viewer"
  }
}
