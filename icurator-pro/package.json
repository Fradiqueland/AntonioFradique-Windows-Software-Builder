{
  "name": "launchbox-pro",
  "version": "0.1.0",
  "description": "LaunchBox Pro — Construtor (gera .exe único por curso via SFX 7-Zip)",
  "main": "main.js",
  "author": "LaunchBox Pro",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:viewer-template": "electron-builder --config build-configs/viewer-template.json --win --x64 && node scripts/prune-viewer-template.js",
    "prune:viewer-template": "node scripts/prune-viewer-template.js",
    "build:builder": "node scripts/check-viewer-template.js && electron-builder --win --x64",
    "build:all": "npm run build:viewer-template && npm run build:builder"
  },
  "build": {
    "appId": "com.launchbox.builder",
    "productName": "LaunchBox Builder",
    "directories": {
      "output": "dist/builder"
    },
    "asarUnpack": [
      "**/node_modules/rcedit/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "preload-viewer.js",
      "src/builder/**/*",
      "src/viewer/**/*",
      "locales/**/*",
      "!src/builder/templates/**",
      "!src/builder/bin/**",
      "!build-configs/**",
      "!scripts/**",
      "!dist/**"
    ],
    "extraResources": [
      { "from": "build-configs/builder-mode/app-mode.json", "to": "app-mode.json" },
      { "from": "src/builder/bin", "to": "sfx" },
      { "from": "src/builder/templates/viewer-core/win-unpacked", "to": "viewer-template", "filter": ["**/*"] }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LaunchBox Builder"
    }
  },
  "dependencies": {
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
