{
  "appId": "com.launchbox.viewer.template",
  "productName": "LaunchBox Viewer",
  "directories": {
    "output": "src/builder/templates/viewer-core"
  },
  "files": [
    "main.js",
    "preload.js",
    "preload-viewer.js",
    "src/viewer/**/*",
    "src/shared/**/*",
    "locales/**/*",
    "!src/builder/**",
    "!build-configs/**",
    "!scripts/**",
    "!dist/**"
  ],
  "extraResources": [
    { "from": "build-configs/viewer-mode/app-mode.json", "to": "app-mode.json" }
  ],
  "win": {
    "target": "dir"
  },
  "asar": true
}
